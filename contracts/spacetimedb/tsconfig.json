{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "src/**/*.ts"]
}
