{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "agent.ts",
    "channels/**/*.ts",
    "hooks/**/*.ts",
    "instrumentation/**/*.ts",
    "lib/**/*.ts",
    "sandbox.ts",
    "test/**/*.ts"
  ]
}
