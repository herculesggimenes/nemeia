{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "typeRoots": ["../frontend/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "spacetimedb": ["../contracts/spacetimedb/node_modules/spacetimedb"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
